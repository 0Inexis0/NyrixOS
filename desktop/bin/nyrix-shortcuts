#!/usr/bin/env python3
"""Edit only NyrixOS key combinations, never commands or unrelated Hyprland config."""
import fcntl, json, os, pathlib, re, shutil, subprocess, sys, tempfile
ROWS = [{'id': 'terminal', 'de': 'Terminal öffnen', 'en': 'Open terminal', 'chord': 'SUPER + Return', 'action': 'hl.dsp.exec_cmd("foot")', 'mouse': False}, {'id': 'terminal-alt', 'de': 'Terminal (Browser-Alternative)', 'en': 'Terminal (browser alternative)', 'chord': 'CTRL + ALT + Return', 'action': 'hl.dsp.exec_cmd("foot")', 'mouse': False}, {'id': 'close', 'de': 'Fenster schließen', 'en': 'Close window', 'chord': 'SUPER + Q', 'action': 'hl.dsp.window.close()', 'mouse': False}, {'id': 'float', 'de': 'Schwebendes Fenster umschalten', 'en': 'Toggle floating window', 'chord': 'SUPER + SHIFT + Space', 'action': 'hl.dsp.window.float({ action = "toggle" })', 'mouse': False}, {'id': 'workspace-1', 'de': 'Workspace 1 öffnen', 'en': 'Open workspace 1', 'chord': 'SUPER + 1', 'action': 'hl.dsp.focus({ workspace = 1 })', 'mouse': False}, {'id': 'move-1', 'de': 'Fenster auf Workspace 1', 'en': 'Move window to workspace 1', 'chord': 'SUPER + SHIFT + 1', 'action': 'hl.dsp.window.move({ workspace = 1 })', 'mouse': False}, {'id': 'workspace-2', 'de': 'Workspace 2 öffnen', 'en': 'Open workspace 2', 'chord': 'SUPER + 2', 'action': 'hl.dsp.focus({ workspace = 2 })', 'mouse': False}, {'id': 'move-2', 'de': 'Fenster auf Workspace 2', 'en': 'Move window to workspace 2', 'chord': 'SUPER + SHIFT + 2', 'action': 'hl.dsp.window.move({ workspace = 2 })', 'mouse': False}, {'id': 'workspace-3', 'de': 'Workspace 3 öffnen', 'en': 'Open workspace 3', 'chord': 'SUPER + 3', 'action': 'hl.dsp.focus({ workspace = 3 })', 'mouse': False}, {'id': 'move-3', 'de': 'Fenster auf Workspace 3', 'en': 'Move window to workspace 3', 'chord': 'SUPER + SHIFT + 3', 'action': 'hl.dsp.window.move({ workspace = 3 })', 'mouse': False}, {'id': 'workspace-4', 'de': 'Workspace 4 öffnen', 'en': 'Open workspace 4', 'chord': 'SUPER + 4', 'action': 'hl.dsp.focus({ workspace = 4 })', 'mouse': False}, {'id': 'move-4', 'de': 'Fenster auf Workspace 4', 'en': 'Move window to workspace 4', 'chord': 'SUPER + SHIFT + 4', 'action': 'hl.dsp.window.move({ workspace = 4 })', 'mouse': False}, {'id': 'workspace-5', 'de': 'Workspace 5 öffnen', 'en': 'Open workspace 5', 'chord': 'SUPER + 5', 'action': 'hl.dsp.focus({ workspace = 5 })', 'mouse': False}, {'id': 'move-5', 'de': 'Fenster auf Workspace 5', 'en': 'Move window to workspace 5', 'chord': 'SUPER + SHIFT + 5', 'action': 'hl.dsp.window.move({ workspace = 5 })', 'mouse': False}, {'id': 'drag', 'de': 'Fenster ziehen (linke Maustaste)', 'en': 'Drag window (left mouse button)', 'chord': 'SUPER + mouse:272', 'action': 'hl.dsp.window.drag()', 'mouse': True}, {'id': 'resize', 'de': 'Fenstergröße (rechte Maustaste)', 'en': 'Resize window (right mouse button)', 'chord': 'SUPER + mouse:273', 'action': 'hl.dsp.window.resize()', 'mouse': True}, {'id': 'controls', 'de': 'Kontrollzentrum', 'en': 'Control center', 'chord': 'SUPER + C', 'action': 'hl.dsp.exec_cmd("nyrix-controls")', 'mouse': False}, {'id': 'controls-alt', 'de': 'Kontrollzentrum (Browser-Alternative)', 'en': 'Control center (browser alternative)', 'chord': 'CTRL + ALT + C', 'action': 'hl.dsp.exec_cmd("nyrix-controls")', 'mouse': False}]
ROOT = pathlib.Path.home()/'.config/nyrix'
MODS = ['SUPER','CTRL','ALT','SHIFT']
KEYS = {k.lower():k for k in ['Return','Space','Tab','Escape','BackSpace','Delete','Insert','Home','End','Page_Up','Page_Down','Left','Right','Up','Down',*[f'F{i}' for i in range(1,25)]]}
class Invalid(Exception): pass
def normalize(raw, mouse=False):
    parts=[p.strip() for p in raw.split('+')]
    if len(parts)<2: raise Invalid('Mindestens eine Modifikatortaste nötig / At least one modifier is required')
    mods=[p.upper().replace('CONTROL','CTRL').replace('WIN','SUPER') for p in parts[:-1]]
    if len(mods)!=len(set(mods)) or any(m not in MODS for m in mods): raise Invalid('Ungültige Modifikatoren / Invalid modifiers')
    key=parts[-1]
    if mouse:
        if key not in ['mouse:272','mouse:273','mouse:274']: raise Invalid('Erwartet: mouse:272, mouse:273 oder mouse:274 / Expected mouse button')
    elif re.fullmatch('[a-zA-Z0-9]',key): key=key.upper()
    elif key.lower() in KEYS: key=KEYS[key.lower()]
    else: raise Invalid('Unbekannte Taste / Unsupported key')
    return ' + '.join([m for m in MODS if m in mods]+[key])
def bindings(overrides):
    out=[]; seen=set()
    if not isinstance(overrides,dict) or set(overrides)-{r['id'] for r in ROWS}: raise Invalid('Ungültige Shortcuts-Datei / Invalid shortcuts file')
    for row in ROWS:
        chord=normalize(overrides.get(row['id'],row['chord']),row['mouse'])
        if chord in seen: raise Invalid('Kombination bereits belegt / Combination already assigned: '+chord)
        seen.add(chord);out.append(dict(row,current=chord))
    return out
def lua(rows):
    return '-- Generated by nyrix-shortcuts. User overrides survive system updates.\n'+''.join('hl.bind('+json.dumps(r['current'])+', '+r['action']+(', { mouse = true }' if r['mouse'] else '')+')\n' for r in rows)
def write(path,data):
    with tempfile.NamedTemporaryFile(mode='w',dir=ROOT,delete=False) as f:
        f.write(data);name=f.name
    os.replace(name,path)
def run(args):
    p=subprocess.run(args,capture_output=True,text=True,timeout=10)
    if p.returncode: raise Invalid(p.stderr.strip() or p.stdout.strip() or 'Hyprland reload failed')
    return p.stdout.strip()
def resolve_instance():
    if os.environ.get('HYPRLAND_INSTANCE_SIGNATURE'): return
    instances=json.loads(run(['hyprctl','instances','-j']))
    matches=[i for i in instances if i.get('wl_socket') == os.environ.get('WAYLAND_DISPLAY')]
    if len(matches)!=1: raise Invalid('Keine eindeutige Hyprland-Sitzung / No unique Hyprland session')
    os.environ['HYPRLAND_INSTANCE_SIGNATURE']=matches[0]['instance']
def main():
    ROOT.mkdir(parents=True,exist_ok=True)
    with (ROOT/'shortcuts.lock').open('w') as lock:
        fcntl.flock(lock,fcntl.LOCK_EX)
        path=ROOT/'shortcuts.json';generated=ROOT/'shortcuts.lua'
        overrides=json.loads(path.read_text()) if path.exists() else {}
        args=sys.argv[1:]
        if args==['list']:
            return {'ok':True,'rows':[{k:v for k,v in r.items() if k!='action'} for r in bindings(overrides)]}
        if len(args)!=3 or args[0]!='set':raise Invalid('Usage: nyrix-shortcuts list | set ID COMBINATION')
        if args[1] not in {r['id'] for r in ROWS}:raise Invalid('Unknown action')
        overrides[args[1]]=args[2]
        rows=bindings(overrides)
        resolve_instance()
        # Refuse existing unrelated errors, so success is attributable to this edit.
        if run(['hyprctl','configerrors']):raise Invalid('Hyprland-Konfiguration zuerst korrigieren / Fix existing Hyprland configuration errors first')
        previous={p:p.read_bytes() if p.exists() else None for p in (path,generated)}
        for p in previous:
            if p.exists():shutil.copy2(p,p.with_suffix(p.suffix+'.bak'))
        try:
            write(generated,lua(rows));write(path,json.dumps(overrides,indent=2)+'\n')
            run(['hyprctl','reload'])
            errors=run(['hyprctl','configerrors'])
            if errors:raise Invalid(errors)
        except Exception:
            for p,data in previous.items():
                if data is None:p.unlink(missing_ok=True)
                else:write(p,data.decode())
            subprocess.run(['hyprctl','reload'],capture_output=True,timeout=10)
            raise
        return {'ok':True,'rows':[{k:v for k,v in r.items() if k!='action'} for r in rows]}
if __name__=='__main__':
    try:print(json.dumps(main(),ensure_ascii=False))
    except Exception as e:
        print(json.dumps({'ok':False,'error':str(e)},ensure_ascii=False));sys.exit(1)
